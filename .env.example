NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_STATIC_URL=
# Map sources (merged; the first source that has a world wins):
# OCAP2 web servers (https://github.com/OCAP2/web) – world list from
# /api/v1/worlds, maps from /images/maps. Comma separated.
# Default: https://replays.vtg.in.ua
NEXT_PUBLIC_OCAP_URLS=
# Optional extra OCAP web server, tried before NEXT_PUBLIC_OCAP_URLS.
NEXT_PUBLIC_OCAP_URL=
# Optional folder with OCAP map packs ({world}/map.json + tiles).
NEXT_PUBLIC_OCAP_MAPS_URL=
# The public OCAP map CDN (maps.ocap2.com, raster tiles) is always used last.
